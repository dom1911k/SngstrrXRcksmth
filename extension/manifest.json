{
  "manifest_version": 3,
  "name": "Bass Trainer for Songsterr",
  "version": "0.4.2",
  "description": "Rocksmith-style bass practice on top of Songsterr: note highway, scoring, tuner and latency calibration.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bass Trainer: open the standalone player"
  },
  "options_ui": {
    "page": "updater/updater.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.songsterr.com/*"
      ],
      "js": [
        "src/adapters/songsterr/page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.songsterr.com/*"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*",
        "src/*/*",
        "src/*/*/*",
        "vendor/*",
        "vendor/*/*"
      ],
      "matches": [
        "https://www.songsterr.com/*"
      ]
    }
  ]
}
