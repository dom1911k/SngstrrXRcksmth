{
  "manifest_version": 3,
  "name": "Bass Trainer for Songsterr",
  "version": "0.1.0",
  "description": "Rocksmith-style bass practice on top of Songsterr: tuner, latency calibration, note highway and scoring.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.songsterr.com/*"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*",
        "src/*/*"
      ],
      "matches": [
        "https://www.songsterr.com/*"
      ]
    }
  ]
}
